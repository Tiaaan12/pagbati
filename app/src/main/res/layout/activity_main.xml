<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Christmas Background -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/christmas_bg"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <!-- Outer Card -->
            <LinearLayout
                android:id="@+id/firstCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/card_border"
                android:padding="5dp"
                android:orientation="vertical">

                <!-- Inner Border -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/inner_border"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Top Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/suprise_intro"
                        android:textColor="#A17C43"
                        android:textSize="12sp"
                        android:gravity="center" />

                    <!-- Decorative Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#B58A5A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/snowflakes"
                            android:textColor="#B58A5A"
                            android:textSize="38sp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#B58A5A" />

                    </LinearLayout>

                    <!-- Main Heading -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/star"
                            android:textColor="#B58A5A"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/txtGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/greeting"
                            android:textColor="#6D1317"
                            android:textSize="38sp"
                            android:fontFamily="@font/great_vibes"
                            android:layout_marginHorizontal="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/star"
                            android:textColor="#B58A5A"
                            android:textSize="18sp" />

                    </LinearLayout>


                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle"
                        android:textColor="#A17C43"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#D5BD83" />

                    <!-- Message -->
                    <TextView
                        android:id="@+id/txtMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/christmas_message"
                        android:textColor="#49312D"
                        android:textSize="15sp"
                        android:fontFamily="@font/lora_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp" />

                    <!-- Signature -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/signature"
                        android:textColor="#7C1E26"
                        android:textSize="17sp"
                        android:layout_marginTop="16dp" />

                    <!-- Gift Button -->
                    <Button
                        android:id="@+id/btnGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/button_text"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/lora_regular"
                        android:textAllCaps="false"
                        android:background="@drawable/gift_button"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECOND CARD: Christmas Surprise -->
            <FrameLayout
                android:id="@+id/secondCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:visibility="gone"
                tools:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Inner Border -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_border"
                    android:padding="24dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Christmas Label -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/surprise_label"
                        android:textColor="@color/christmas_green"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="25dp"/>

                    <!-- Main Heading -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/mama_heading"
                        android:textColor="#6D1317"
                        android:textSize="24sp"
                        android:fontFamily="@font/great_vibes"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/photo_frame"
                        android:padding="10dp"
                        android:gravity="center">

                        <!-- Mother's Photo -->
                        <ImageView
                            android:id="@+id/imgMama"
                            android:layout_width="240dp"
                            android:layout_height="220dp"
                            android:src="@drawable/mother_photo"
                            android:scaleType="centerCrop"
                            android:contentDescription="Photo of Mama" />

                    </LinearLayout>

                    <!-- Letter Greeting -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mama_dear"
                        android:textColor="#245C45"
                        android:textSize="19sp"
                        android:fontFamily="@font/lora_regular"
                        android:gravity="start" />

                    <!-- Personal Message -->
                    <TextView
                        android:id="@+id/txtMamaMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/mama_message"
                        android:textColor="#49312D"
                        android:textSize="15sp"
                        android:fontFamily="@font/lora_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp" />

                    <!-- Signature -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/mama_signature"
                        android:textColor="#7C1E26"
                        android:textSize="19sp"
                        android:fontFamily="@font/great_vibes"
                        android:gravity="end" />

                    <!-- Christmas Footer -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/mama_footer"
                        android:textColor="@color/christmas_green"
                        android:textSize="13sp"
                        android:gravity="center" />

                    <!-- Back Button -->
                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/back_button_text"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/lora_regular"
                        android:textAllCaps="false"
                        android:background="@drawable/gift_button"
                        app:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/christmas_ribbon"
                    android:scaleType="fitCenter"
                    android:translationY="-55dp"
                    android:elevation="8dp"
                    android:contentDescription="Burgundy Christmas ribbon" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
